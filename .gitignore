# Binaries for programs and plugins
# Add your compiled binary name here if it's different or you build locally
my-go-app
my-go-app.exe
app
app.exe

# Test binaries generated by 'go test -c'
*.test

# Output of coverage tools like 'go test -coverprofile'
*.out
*.prof
coverage.*

# Dependency directory (if using 'go mod vendor')
# Usually best to ignore this and rely on go.mod/go.sum
# vendor/

# Environment variables file
# Never commit your actual .env file with secrets!
.env
.env.*
!.env.example
!.env.sample

# Log files
*.log

# IDE/Editor specific files and directories
.idea/
.vscode/
*.swp
*~
*.sublime-project
*.sublime-workspace

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini

# Compiled binary files (less common with Go modules, but good practice)
*.[oa]